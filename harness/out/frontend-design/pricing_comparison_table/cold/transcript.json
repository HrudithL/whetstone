        "id": "toolu_01B8E9LN76bF3YbgHXdQANSr",
        "name": "Write",
        "input": {
          "file_path": "index.html",
          "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Marrow \u2014 Pricing</title>\n<style>\n  /* ============ Marrow \u00b7 pricing ============\n     Subject: a test-coverage-mapping CLI. The design borrows from the tool's\n     own artifact \u2014 the coverage grid: a matrix of cells, lit where tests reach.\n     Palette: deep terminal ink + warm \"bone\" type + a single marrow-coral accent.\n  */\n  :root{\n    --ink:      #0C0F14;\n    --panel:    #12161D;\n    --panel-2:  #161B23;\n    --line:     #232B36;\n    --bone:     #ECE6D9;\n    --muted:    #8A93A1;\n    --dim:      #5C6472;\n    --accent:   #FF6A3D;\n    --accent-d: #C74A26;\n    --covered:  #57C7A6;\n    --radius:   14px;\n    --mono: ui-monospace, \"SF Mono\", \"SFMono-Regular\", Menlo, Consolas, \"Liberation Mono\", monospace;\n    --sans: system-ui, -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif;\n  }\n\n  *{ box-sizing:border-box; }\n\n  html{ -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; }\n\n  body{\n    margin:0;\n    background:\n      radial-gradient(1200px 600px at 80% -10%, rgba(255,106,61,.10), transparent 60%),\n      radial-gradient(900px 500px at 0% 110%, rgba(87,199,166,.06), transparent 55%),\n      var(--ink);\n    color:var(--bone);\n    font-family:var(--sans);\n    line-height:1.5;\n    min-height:100vh;\n  }\n\n  .wrap{\n    max-width:1120px;\n    margin:0 auto;\n    padding:clamp(56px,9vw,120px) clamp(20px,5vw,40px);\n  }\n\n  /* ---------- Section heading ---------- */\n  .head{ margin-bottom:clamp(40px,6vw,72px); }\n\n  .kicker{\n    font-family:var(--mono);\n    font-size:12.5px;\n    letter-spacing:.14em;\n    color:var(--accent);\n    display:inline-flex;\n    align-items:center;\n    gap:.6em;\n    margin:0 0 20px;\n  }\n  .kicker::before{\n    content:\"\";\n    width:26px; height:1px;\n    background:linear-gradient(90deg, var(--accent), transparent);\n  }\n  .kicker .caret{ color:var(--dim); }\n\n  h1{\n    font-size:clamp(42px,7vw,74px);\n    line-height:.98;\n    letter-spacing:-.03em;\n    font-weight:680;\n    margin:0 0 18px;\n  }\n\n  .sub{\n    font-size:clamp(16px,2vw,18.5px);\n    color:var(--muted);\n    max-width:34ch;\n    margin:0;\n  }\n  .sub b{ color:var(--bone); font-weight:600; }\n\n  /* ---------- Card grid ---------- */\n  .grid{\n    display:grid;\n    grid-template-columns:repeat(3, 1fr);\n    gap:20px;\n    align-items:stretch;\n  }\n\n  .card{\n    position:relative;\n    display:flex;\n    flex-direction:column;\n    background:linear-gradient(180deg, var(--panel-2), var(--panel));\n    border:1px solid var(--line);\n    border-radius:var(--radius);\n    padding:30px 28px 32px;\n    overflow:hidden;\n    transition:transform .35s cubic-bezier(.2,.7,.2,1), border-color .35s, box-shadow .35s;\n  }\n  .card:hover{\n    transform:translateY(-6px);\n    border-color:#33404f;\n    box-shadow:0 24px 60px -30px rgba(0,0,0,.8);\n  }\n\n  /* Recommended tier \u2014 lit, elevated */\n  .card.reco{\n    border-color:rgba(255,106,61,.42);\n    background:\n      linear-gradient(180deg, rgba(255,106,61,.08), transparent 220px),\n      linear-gradient(180deg, var(--panel-2), var(--panel));\n    box-shadow:0 30px 70px -34px rgba(255,106,61,.35);\n    z-index:2;\n  }\n  @media(min-width:861px){ .card.reco{ transform:translateY(-14px); } .card.reco:hover{ transform:translateY(-20px); } }\n\n  /* coverage-grid motif in the top-right of each card */\n  .covmap{\n    position:absolute;\n    top:24px; right:22px;\n    display:grid;\n    grid-template-columns:repeat(5, 6px);\n    grid-auto-rows:6px;\n    gap:3px;\n    opacity:.55;\n  }\n  .covmap i{ background:var(--line); border-radius:1.5px; }\n  .covmap i.on{ background:var(--dim); }\n  .card.reco .covmap i.on{ background:var(--accent); box-shadow:0 0 6px rgba(255,106,61,.6); }\n  .card.reco .covmap i.half{ background:var(--accent-d); }\n\n  .badge{\n    position:absolute;\n    top:0; left:28px;\n    transform:translateY(-50%);\n    font-family:var(--mono);\n    font-size:11px;\n    letter-spacing:.13em;\n    color:var(--ink);\n    background:var(--accent);\n    padding:5px 11px;\n    border-radius:100px;\n    font-weight:600;\n  }\n\n  .tier{\n    font-family:var(--mono);\n    font-size:13px;\n    letter-spacing:.16em;\n    text-transform:uppercase;\n    color:var(--muted);\n    margin:2px 0 22px;\n  }\n  .card.reco .tier{ color:var(--accent); }\n\n  .price{\n    display:flex;\n    align-items:baseline;\n    gap:8px;\n    flex-wrap:wrap;\n    margin-bottom:26px;\n    min-height:52px;\n  }\n  .amount{\n    font-size:46px;\n    font-weight:680;\n    letter-spacing:-.03em;\n    line-height:1;\n    font-family:var(--sans);\n  }\n  .period{\n    font-family:var(--mono);\n    font-size:13px;\n    color:var(--dim);\n    letter-spacing:.02em;\n  }\n\n  /* ---------- CTA ---------- */\n  .cta{\n    display:block;\n    width:100%;\n    text-align:center;\n    font-family:var(--mono);\n    font-size:14px;\n    letter-spacing:.02em;\n    padding:14px 16px;\n    border-radius:10px;\n    border:1px solid var(--line);\n    background:transparent;\n    color:var(--bone);\n    cursor:pointer;\n    text-decoration:none;\n    transition:background .25s, border-color .25s, color .25s, transform .1s;\n  }\n  .cta:hover{ background:rgba(255,255,255,.04); border-color:#3a4757; }\n  .cta:active{ transform:translateY(1px); }\n  .cta.primary{\n    background:var(--accent);\n    border-color:var(--accent);\n    color:#1a0d07;\n    font-weight:600;\n  }\n  .cta.primary:hover{ background:#ff7d55; border-color:#ff7d55; }\n  .cta::before{ content:\"\u203a \"; color:currentColor; opacity:.55; }\n\n  /* ---------- Features ---------- */\n  .divider{\n    height:1px;\n    background:var(--line);\n    margin:28px 0 22px;\n  }\n  .feat{\n    list-style:none;\n    margin:0; padding:0;\n    display:flex;\n    flex-direction:column;\n    gap:14px;\n    flex-grow:1;\n  }\n  .feat li{\n    display:flex;\n    align-items:flex-start;\n    gap:11px;\n    font-size:14.5px;\n    color:var(--bone);\n  }\n  /* coverage-cell bullet */\n  .feat li::before{\n    content:\"\";\n    flex:none;\n    width:9px; height:9px;\n    margin-top:5px;\n    border-radius:2px;\n    background:var(--covered);\n    box-shadow:0 0 0 1px rgba(87,199,166,.25);\n  }\n  .card.reco .feat li::before{ background:var(--accent); box-shadow:0 0 0 1px rgba(255,106,61,.3); }\n\n  /* \"Everything in X\" \u2014 an inherited line, styled distinctly */\n  .feat li.inherit{\n    font-family:var(--mono);\n    font-size:12.5px;\n    letter-spacing:.02em;\n    color:var(--muted);\n    padding-bottom:2px;\n  }\n  .feat li.inherit::before{\n    content:\"+\";\n    background:none;\n    box-shadow:none;\n    width:auto; height:auto;\n    margin-top:0;\n    color:var(--dim);\n    font-family:var(--mono);\n    font-size:14px;\n    line-height:1.4;\n  }\n  .feat li.inherit b{ color:var(--bone); font-weight:600; }\n\n  /* ---------- entrance motion ---------- */\n  @keyframes rise{ from{ opacity:0; transform:translateY(14px); } to{ opacity:1; transform:none; } }\n  .card{ animation:rise .6s cubic-bezier(.2,.7,.2,1) both; }\n  .card:nth-child(1){ animation-delay:.05s; }\n  .card:nth-child(2){ animation-delay:.13s; }\n  .card:nth-child(3){ animation-delay:.21s; }\n  .covmap i.on{ animation:cell .5s ease both; }\n  @keyframes cell{ from{ opacity:0; } to{ opacity:1; } }\n\n  .foot{\n    margin-top:36px;\n    font-family:var(--mono);\n    font-size:12.5px;\n    color:var(--dim);\n    letter-spacing:.02em;\n  }\n  .foot .dot{ color:var(--covered); }\n\n  /* ---------- responsive ---------- */\n  @media(max-width:860px){\n    .grid{ grid-template-columns:1fr; max-width:440px; }\n    .card.reco{ order:-1; }\n  }\n\n  /* ---------- focus + reduced motion ---------- */\n  a:focus-visible, .cta:focus-visible{\n    outline:2px solid var(--accen