0deg, var(--accent), transparent);\n  }\n  .kicker .caret{ color:var(--dim); }\n\n  h1{\n    font-size:clamp(42px,7vw,74px);\n    line-height:.98;\n    letter-spacing:-.03em;\n    font-weight:680;\n    margin:0 0 18px;\n  }\n\n  .sub{\n    font-size:clamp(16px,2vw,18.5px);\n    color:var(--muted);\n    max-width:34ch;\n    margin:0;\n  }\n  .sub b{ color:var(--bone); font-weight:600; }\n\n  /* ---------- Card grid ---------- */\n  .grid{\n    display:grid;\n    grid-template-columns:repeat(3, 1fr);\n    gap:20px;\n    align-items:stretch;\n  }\n\n  .card{\n    position:relative;\n    display:flex;\n    flex-direction:column;\n    background:linear-gradient(180deg, var(--panel-2), var(--panel));\n    border:1px solid var(--line);\n    border-radius:var(--radius);\n    padding:30px 28px 32px;\n    overflow:hidden;\n    transition:transform .35s cubic-bezier(.2,.7,.2,1), border-color .35s, box-shadow .35s;\n  }\n  .card:hover{\n    transform:translateY(-6px);\n    border-color:#33404f;\n    box-shadow:0 24px 60px -30px rgba(0,0,0,.8);\n  }\n\n  /* Recommended tier \u2014 lit, elevated */\n  .card.reco{\n    border-color:rgba(255,106,61,.42);\n    background:\n      linear-gradient(180deg, rgba(255,106,61,.08), transparent 220px),\n      linear-gradient(180deg, var(--panel-2), var(--panel));\n    box-shadow:0 30px 70px -34px rgba(255,106,61,.35);\n    z-index:2;\n  }\n  @media(min-width:861px){ .card.reco{ transform:translateY(-14px); } .card.reco:hover{ transform:translateY(-20px); } }\n\n  /* coverage-grid motif in the top-right of each card */\n  .covmap{\n    position:absolute;\n    top:24px; right:22px;\n    display:grid;\n    grid-template-columns:repeat(5, 6px);\n    grid-auto-rows:6px;\n    gap:3px;\n    opacity:.55;\n  }\n  .covmap i{ background:var(--line); border-radius:1.5px; }\n  .covmap i.on{ background:var(--dim); }\n  .card.reco .covmap i.on{ background:var(--accent); box-shadow:0 0 6px rgba(255,106,61,.6); }\n  .card.reco .covmap i.half{ background:var(